6. agents/orchestrator.py

from agents.log_agent import analyze_logs
from agents.deployment_agent import diagnose_issue
from agents.remediation_agent import suggest_fix


def analyze_deployment(payload):
    logs = payload.get("logs")

    log_analysis = analyze_logs(logs)

    diagnosis = diagnose_issue(log_analysis)

    remediation = suggest_fix(diagnosis)

    return {
        "analysis": log_analysis,
        "diagnosis": diagnosis,
        "remediation": remediation
    }


