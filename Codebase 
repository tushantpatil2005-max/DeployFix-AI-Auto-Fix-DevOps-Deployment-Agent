def suggest_fix(diagnosis):

    issue = diagnosis.get("issue")

    if issue == "Kubernetes container crash":
        return {
            "solution": "Verify Kubernetes secrets and environment variables"
        }

    if issue == "Database connectivity issue":
        return {
            "solution": "Restart database service and verify network policies"
        }

    return {
        "solution": "Escalate to infrastructure engineering team"
    }


def execute_recovery(payload):
    return {
        "status": "Recovery workflow executed",
        "details": payload
    }


