8. agents/deployment_agent.py

def diagnose_issue(log_analysis):

    if "CrashLoopBackOff" in log_analysis:
        return {
            "issue": "Kubernetes container crash",
            "root_cause": "Missing environment variable"
        }

    if "connection refused" in log_analysis.lower():
        return {
            "issue": "Database connectivity issue",
            "root_cause": "Database unavailable"
        }

    return {
        "issue": "Unknown deployment issue",
        "root_cause": "Requires manual investigation"
    }


